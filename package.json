{
  "name": "scriptorium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scriptorium \u2014 a modern markdown wiki: SvelteKit 2 + Svelte 5, Tailwind, SQLite, Docker, Helm.",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "node web/build/index.js",
    "start:api": "node server/index.js",
    "test": "npm run test -w server",
    "check": "npm run check -w web"
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
