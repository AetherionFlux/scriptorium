{
  "name": "scriptorium-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scriptorium frontend — SvelteKit 2 (Svelte 5 runes), Tailwind CSS 4, CodeMirror 6 editor.",
  "scripts": {
    "dev": "vite dev --port 5173",
